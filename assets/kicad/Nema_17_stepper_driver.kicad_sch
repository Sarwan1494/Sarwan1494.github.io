	(text "Load Capacitor C_l = 2 * (C_l - C_s) = 2 * (10-5)pF = 10pF\nAssume C_s = 5pF\n\nS pin in CAN Transceiver is used to disable transmission. Only possible to receive\nIt is prefered to keep the pull up resistors for I2C at the host side. Typical value 2.2Kohms\n\nMotor driver - DRV8833PW - Dual H-Bridge (1.5A RMS, Max voltage: 10.8V) - Obsolete\n\nDRV8844PWPR - Dual H Bridge (1.25A RMS, Max voltage: 36V)"
		(exclude_from_sim no)
		(at 16.002 234.696 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "b5667a4f-6f47-46a9-8fb7-fe1fac1875a3")
	)
